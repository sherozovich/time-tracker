# Groq API config (optional — only used for "topic summary" feature).
# Copy this file to `groq.env` and fill in your own keys.
# Groq key:   https://console.groq.com/keys
# Gemini key: https://aistudio.google.com/apikey

GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_TOPIC_MODEL="llama-3.1-8b-instant"

# Used by the "Ask" feature on the dashboard (natural-language Q&A over sessions).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
